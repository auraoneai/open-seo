# OpenSEO Cloudflare self-host. Walkthrough: docs/SELF_HOSTING_CLOUDFLARE_ALCHEMY.md

# ---------- Required ----------

# Get one at https://dataforseo.com — see docs/DATAFORSEO_API_KEY.md
DATAFORSEO_API_KEY=

# Who may sign in through Cloudflare Access, comma-separated
ACCESS_ALLOWED_EMAILS=

# ---------- Optional — uncomment to use ----------

# Google Search Console (all three together) — docs/SELF_HOSTING_GOOGLE_SEARCH_CONSOLE.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_SECRET=

# SAM, the in-app agent (hidden if unset)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Your own PostHog product analytics
# POSTHOG_PUBLIC_KEY=
# POSTHOG_HOST=

# Opt out of anonymized telemetry — docs/SELF_HOSTING_CLOUDFLARE_OPERATIONS.md
# OPENSEO_TELEMETRY_DISABLED=1

# Serve the app on your own Cloudflare-zone hostname instead of workers.dev.
# The Access application moves to it too and workers.dev is disabled.
# The zone must already exist in the Cloudflare account.
# SELFHOST_CUSTOM_DOMAIN=seo.example.com

# Managed OAuth is enabled on the Access app by deploy:selfhost
# (scripts/selfhost-managed-oauth.mjs). Set this to hide the setup warning.
# SELFHOST_MANAGED_OAUTH=1

# Bring your own Cloudflare Access application instead of the auto-provisioned
# one (ACCESS_ALLOWED_EMAILS is then ignored)
# TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# POLICY_AUD=your-access-application-audience-tag
